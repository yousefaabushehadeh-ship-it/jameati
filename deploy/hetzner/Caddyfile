{$SITE_DOMAIN} {
	encode zstd gzip

	# الباك إند
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /actuator/health {
		reverse_proxy api:8080
	}

	# الموقع (React) مع رجوع كل المسارات لـ index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}

# www.الدومين ← تحويل للدومين الأساسي (بس إذا WWW_DOMAIN محدد بـ .env)
{$WWW_DOMAIN:http://www.invalid} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
